# Cấu hình môi trường cho backend ConfGuide
PORT=3000

# Origin của frontend được phép gọi API qua CORS (có thể ngăn cách nhiều origin bằng dấu phẩy)
FRONTEND_ORIGIN=http://127.0.0.1:5500,http://localhost:5500,http://[::1]:5500,http://localhost:8000,http://127.0.0.1:8000,http://localhost:3000,http://127.0.0.1:3000

# Google OAuth 2.0 Web Client ID (chỉ dùng xác thực ID token để lấy name, email, picture)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# (Tùy chọn) API Key SerpApi Google Scholar (cache 24h, dừng trước ngưỡng 250 lượt/tháng)
SERPAPI_API_KEY=

# (Tùy chọn) API Key cho Semantic Scholar (mặc định dùng luồng công khai không cần key nếu ORCID chưa có)
SEMANTIC_SCHOLAR_API_KEY=

# ===== Trợ lý AI (chatbox hỏi đáp & gợi ý hội nghị theo abstract) =====
# (Tùy chọn) API Key Google Gemini (lấy miễn phí tại https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# (Tùy chọn) Các model Gemini ngăn cách bởi dấu phẩy, thử lần lượt khi model trước quá tải.
# Để trống = gemini-3.5-flash,gemini-3.5-flash-lite
GEMINI_MODEL=
